From 343ecb1d07b77e40e8fa148939e0d6bb0e7ee3bf Mon Sep 17 00:00:00 2001
From: nb <nb@local>
Date: Sun, 4 Oct 2026 11:01:05 +0300
Subject: [PATCH 1/3] jump cache: 16 bits, aarch64-friendly hash

---
 accel/tcg/tb-hash.h      | 3 ++-
 accel/tcg/tb-jmp-cache.h | 4 +++-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/accel/tcg/tb-hash.h b/accel/tcg/tb-hash.h
index a0c61f25c..57f40e09e 100644
--- a/accel/tcg/tb-hash.h
+++ b/accel/tcg/tb-hash.h
@@ -55,7 +55,8 @@ static inline unsigned int tb_jmp_cache_hash_func(vaddr pc)
 /* In user-mode we can get better hashing because we do not have a TLB */
 static inline unsigned int tb_jmp_cache_hash_func(vaddr pc)
 {
-    return (pc ^ (pc >> TB_JMP_CACHE_BITS)) & (TB_JMP_CACHE_SIZE - 1);
+    /* nbhost: AArch64 PCs are 4-byte aligned; drop the 2 zero bits so every entry can be used */
+    return ((pc >> 2) ^ (pc >> (2 + TB_JMP_CACHE_BITS))) & (TB_JMP_CACHE_SIZE - 1);
 }
 
 #endif /* CONFIG_SOFTMMU */
diff --git a/accel/tcg/tb-jmp-cache.h b/accel/tcg/tb-jmp-cache.h
index bb424c8a0..6ae0cf823 100644
--- a/accel/tcg/tb-jmp-cache.h
+++ b/accel/tcg/tb-jmp-cache.h
@@ -9,7 +9,9 @@
 #ifndef ACCEL_TCG_TB_JMP_CACHE_H
 #define ACCEL_TCG_TB_JMP_CACHE_H
 
-#define TB_JMP_CACHE_BITS 12
+#ifndef TB_JMP_CACHE_BITS
+#define TB_JMP_CACHE_BITS 16   /* nbhost: was 12; the game's indirect-branch working set is large */
+#endif
 #define TB_JMP_CACHE_SIZE (1 << TB_JMP_CACHE_BITS)
 
 /*
